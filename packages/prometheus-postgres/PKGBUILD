pkgname="carbonio-prometheus-postgres-exporter"
pkgver="0.19.1"
pkgrel="1"
pkgdesc="Postgres exporter for open-source systems monitoring and alerting toolkit"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('aarch64' 'x86_64')
license=('Apache-2.0')
depends=("systemd")
conflicts=('prometheus-postgres-exporter')
backup=("etc/default/${pkgname}")

source=(
  "${pkgname}.default"
  "${pkgname}.service"
  "${pkgname}.yml"
  "${pkgname}-consul.hcl"
  "set-${pkgname}.sh"
)
source_aarch64=("https://github.com/prometheus-community/postgres_exporter/releases/download/v${pkgver}/postgres_exporter-${pkgver}.linux-arm64.tar.gz")
source_x86_64=("https://github.com/prometheus-community/postgres_exporter/releases/download/v${pkgver}/postgres_exporter-${pkgver}.linux-amd64.tar.gz")
sha256sums=(
  'ceb07622ff5e2483b92b6b7acc9c190e00c56dd347278c64f1e080ac0830632b'
  '2307d2bed92d80c41cdcf3c65cdc95e57329dd28c7fa9913b0c1571598e3cc70'
  'cb3f91d54eee30e53e35b2b99905f70f169ed549fd78909d3dac2defc9ed8d3b'
  '634fd8048f73aeb1e92b4f700b82615b1cc2e0f634dd202eac4b58c419d4ec00'
  '7f9e5658369bb5524fef1129e52d02af6fb05a627ac59aa032d9ede3b42efd78'
)
sha256sums_aarch64=('0ac6fe8c1f66f13b12adb8da282d248d9e1a48df6684e453ca232fd8fd62a11a')
sha256sums_x86_64=('229096c7988df6ca41fe5b4bf66865089971535e7f0d819c12c920ec64dd2bd0')

package() {
  if [ "${CARCH}" = "aarch64" ]; then
    cd "${srcdir}/postgres_exporter-${pkgver}.linux-arm64"
  else
    cd "${srcdir}/postgres_exporter-${pkgver}.linux-amd64"
  fi

  install -Dm755 "postgres_exporter" \
    "${pkgdir}/usr/bin/${pkgname}"

  install -Dm755 "${srcdir}/set-${pkgname}.sh" \
    "${pkgdir}/usr/bin/set-${pkgname}.sh"

  install -Dm644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm644 "${srcdir}/${pkgname}.default" \
    "${pkgdir}/etc/default/${pkgname}"
  install -Dm644 "${srcdir}/${pkgname}.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/${pkgname}.yml"

  install -Dm644 "${srcdir}/${pkgname}-consul.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"
}

postinst() {
  getent group 'carbonio-prometheus' >/dev/null \
    || groupadd -r 'carbonio-prometheus'
  if ! getent passwd 'carbonio-prometheus' >/dev/null; then
    useradd -r -M -g 'carbonio-prometheus' -s /sbin/nologin 'carbonio-prometheus'
  else
    if [ "$(getent passwd 'carbonio-prometheus' | cut -d: -f6)" != "/home/carbonio-prometheus" ]; then
      usermod -d /home/carbonio-prometheus 'carbonio-prometheus'
    fi
  fi

  chown -R carbonio-prometheus:carbonio-prometheus /etc/carbonio/carbonio-prometheus-postgres-exporter

  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  /usr/bin/set-carbonio-prometheus-postgres-exporter.sh

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-prometheus-postgres-exporter.service >/dev/null 2>&1 || :
    systemctl start carbonio-prometheus-postgres-exporter.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Postgres Exporter installed successfully!"
  echo "You must reload service discover or add this host to prometheus.yml"
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-prometheus-postgres-exporter.service >/dev/null 2>&1 || :
    systemctl stop carbonio-prometheus-postgres-exporter.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
