pkgname="carbonio-prometheus-nginx-exporter"
pkgver="1.5.3"
pkgrel="1"
pkgdesc="Nginx exporter for open-source systems monitoring and alerting toolkit"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('aarch64' 'x86_64')
license=('Apache-2.0')
depends=("systemd")
conflicts=("prometheus-nginx-exporter")
backup=("etc/zextras/service-discover/${pkgname}.hcl")

source=(
  "${pkgname}.default"
  "${pkgname}.service"
  "${pkgname}-consul.hcl"
)
source_aarch64=("https://github.com/nginx/nginx-prometheus-exporter/releases/download/v${pkgver}/nginx-prometheus-exporter_${pkgver}_linux_arm64.tar.gz")
source_x86_64=("https://github.com/nginx/nginx-prometheus-exporter/releases/download/v${pkgver}/nginx-prometheus-exporter_${pkgver}_linux_amd64.tar.gz")
sha256sums=(
  '6927553baccafe09cb9ba0a9117020c9099b2edc68865b5e8a7b78797fafcf08'
  '195baf15dcab360b6093d9d918b8b8cdba7df9abd12dad2973e104c3e1ca3cee'
  '9e0174bfd8187d9b324cce8b70f47b10c12522629e97dbb1cd239281d3f608f1'
)
sha256sums_aarch64=('a0b1a5f5bba09483bd2e04c759c1a75fffe46ca72c0314ee2bb925d1742ff23b')
sha256sums_x86_64=('3a0dd1ea6db57cd360544d0aed38df4adabcfeb31e931dc481d535c66f92641d')

package() {
  install -Dm755 "${srcdir}/nginx-prometheus-exporter" \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm644 "${srcdir}/${pkgname}.default" \
    "${pkgdir}/etc/default/${pkgname}"

  install -Dm644 "${srcdir}/${pkgname}-consul.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"
}

postinst() {
  getent group 'carbonio-prometheus' >/dev/null \
    || groupadd -r 'carbonio-prometheus'
  if ! getent passwd 'carbonio-prometheus' >/dev/null; then
    useradd -r -M -g 'carbonio-prometheus' -s /sbin/nologin 'carbonio-prometheus'
  else
    if [ "$(getent passwd 'carbonio-prometheus' | cut -d: -f6)" != "/home/carbonio-prometheus" ]; then
      usermod -d /home/carbonio-prometheus 'carbonio-prometheus'
    fi
  fi

  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-prometheus-nginx-exporter.service >/dev/null 2>&1 || :
    systemctl start carbonio-prometheus-nginx-exporter.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Nginx Exporter installed successfully!"
  echo "You must reload service discover or add this host to prometheus.yml"
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-prometheus-nginx-exporter.service >/dev/null 2>&1 || :
    systemctl stop carbonio-prometheus-nginx-exporter.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
