depends=(
  "systemd"
)

conflicts=(
  "prometheus"
)

backup=(
  "etc/carbonio/${pkgname}/prometheus.yml"
)

package() {
  cd "${srcdir}"

  install -Dm 755 "131-carbonio-prometheus.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/131-carbonio-prometheus.sh"
  install -Dm 644 "prometheus.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm 644 "prometheus.default" \
    "${pkgdir}/etc/default/${pkgname}"
  install -Dm 644 "${srcdir}/${pkgname}-consul.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"

  cd "${srcdir}/prometheus-${pkgver}.linux-amd64"
  install -Dm 755 prometheus "${pkgdir}/usr/bin/prometheus"
  install -Dm 755 promtool "${pkgdir}/usr/bin/promtool"
  install -dm 750 "${pkgdir}/var/lib/prometheus"
  install -dm 750 "${pkgdir}/etc/carbonio/${pkgname}/rules"
  install -dm 750 "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -dm 750 "${pkgdir}/etc/carbonio/${pkgname}/sample-alertmanager"
  install -dm 750 "${pkgdir}/etc/carbonio/${pkgname}/alertmanager"
  install -Dm 640 "${srcdir}/prometheus.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/prometheus.yml"
  install -Dm 640 "${srcdir}/policies.json" \
    "${pkgdir}/etc/carbonio/${pkgname}/service-discover/policies.json"
    
  # Prometheus sample-rules:
  install -Dm 640 "${srcdir}/clamav.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -Dm 640 "${srcdir}/consul.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -Dm 640 "${srcdir}/mta_queues.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -Dm 640 "${srcdir}/mysql.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -Dm 640 "${srcdir}/nginx.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -Dm 640 "${srcdir}/node-exporter.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"
  install -Dm 640 "${srcdir}/postgres.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-rules"

  install -Dm 640 "${srcdir}/alertmanager.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/sample-alertmanager"
}

postinst() {
  getent group 'carbonio-prometheus' >/dev/null ||
    groupadd -r 'carbonio-prometheus'

  if ! getent passwd 'carbonio-prometheus' >/dev/null; then
    useradd -r -M -g 'carbonio-prometheus' -s /sbin/nologin 'carbonio-prometheus'
  else
    if [ "$(getent passwd 'carbonio-prometheus' | cut -d: -f6)" != "/home/carbonio-prometheus" ]; then
      usermod -d /home/carbonio-prometheus 'carbonio-prometheus'
    fi
  fi

  chown -R carbonio-prometheus:carbonio-prometheus /etc/carbonio/carbonio-prometheus
  chown -R carbonio-prometheus:carbonio-prometheus /var/lib/prometheus

  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-prometheus.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Prometheus installed successfully!"
  echo "You must run pending-setups to configure it."
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-prometheus >/dev/null 2>&1 || :
    systemctl stop carbonio-prometheus >/dev/null 2>&1 || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
