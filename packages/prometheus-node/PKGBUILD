pkgname="carbonio-prometheus-node-exporter"
pkgver="1.10.2"
pkgrel="3"
pkgdesc="Node exporter for open-source systems monitoring and alerting toolkit"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('x86_64')
license=('Apache-2.0')
source=(
  "https://github.com/prometheus/node_exporter/releases/download/v${pkgver}/node_exporter-${pkgver}.linux-amd64.tar.gz"
  "${pkgname}.default"
  "${pkgname}-consul.hcl"
  "${pkgname}.service"
  "node_packages.sh"
)
sha256sums=(
  'c46e5b6f53948477ff3a19d97c58307394a29fe64a01905646f026ddc32cb65b'
  '8f7ca757c4a98ce33e77c41c1915c6699173dc5535af3c6006b6e091ef7f9d11'
  'cf0181015a41c54d52b06786512a12b9b9bef47531e5e64cf3838f84788703ea'
  '18d4ffb8963b6abbc293376171f5a1bb5b062bd566177bafcd6a873481a446b4'
  'c0759b34a7232f04c08c343fdbdc4785efea7376c0cc8371af3f215342dbf495'
)

depends_apt=(
  "systemd"
)

depends__yum=(
  "systemd"
  "python3-dnf-plugin-post-transaction-actions"
)

backup=(
  "etc/default/${pkgname}"
)

conflicts=(
  "prometheus-node-exporter"
)

package() {
  cd "${srcdir}/node_exporter-${pkgver}.linux-amd64"

  install -Dm 755 node_exporter \
    "${pkgdir}/usr/bin/${pkgname}"

  install -Dm 644 "${srcdir}/${pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm 644 "${srcdir}/${pkgname}.default" \
    "${pkgdir}/etc/default/${pkgname}"

  install -Dm 644 "${srcdir}/${pkgname}-consul.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"

  install -Dm 755 "${srcdir}/node_packages.sh" \
    "${pkgdir}/usr/local/sbin/node_packages.sh"
}

postinst__apt() {
  getent group 'carbonio-prometheus' >/dev/null ||
    groupadd -r 'carbonio-prometheus'

  if ! getent passwd 'carbonio-prometheus' >/dev/null; then
    useradd -r -M -g 'carbonio-prometheus' -s /sbin/nologin 'carbonio-prometheus'
  else
    if [ "$(getent passwd 'carbonio-prometheus' | cut -d: -f6)" != "/home/carbonio-prometheus" ]; then
      usermod -d /home/carbonio-prometheus 'carbonio-prometheus'
    fi
  fi

 # Configure post-apt hook for node_packages.sh
  if [ -x /usr/local/sbin/node_packages.sh ]; then
    mkdir -p /etc/apt/apt.conf.d
    echo 'DPkg::Post-Invoke {"/usr/local/sbin/node_packages.sh";};' \
      > /etc/apt/apt.conf.d/100post-apt
    chmod 644 /etc/apt/apt.conf.d/100post-apt
  fi

  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-prometheus-node-exporter.service >/dev/null 2>&1 || :
    systemctl start carbonio-prometheus-node-exporter.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Node Exporter installed successfully!"
  echo "You must reload service discover or add this host to prometheus.yml"
  echo "======================================================"
}

postinst__yum() {
  getent group 'carbonio-prometheus' >/dev/null ||
    groupadd -r 'carbonio-prometheus'

  if ! getent passwd 'carbonio-prometheus' >/dev/null; then
    useradd -r -M -g 'carbonio-prometheus' -s /sbin/nologin 'carbonio-prometheus'
  else
    if [ "$(getent passwd 'carbonio-prometheus' | cut -d: -f6)" != "/home/carbonio-prometheus" ]; then
      usermod -d /home/carbonio-prometheus 'carbonio-prometheus'
    fi
  fi

  # configuring DNF post-transaction hook for node_packages.sh
  if [ -x /usr/local/sbin/node_packages.sh ]; then
    mkdir -p /etc/dnf/plugins/post-transaction-actions.d
    echo '*:any:/usr/local/sbin/node_packages.sh' \
      > /etc/dnf/plugins/post-transaction-actions.d/post-dnf.action
    chmod 644 /etc/dnf/plugins/post-transaction-actions.d/post-dnf.action
  fi

  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable carbonio-prometheus-node-exporter.service >/dev/null 2>&1 || :
    systemctl start carbonio-prometheus-node-exporter.service >/dev/null 2>&1 || :
  fi
  
  echo "======================================================"
  echo "Carbonio Node Exporter installed successfully!"
  echo "You must reload service discover or add this host to prometheus.yml"
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-prometheus-node-exporter.service >/dev/null 2>&1 || :
    systemctl stop carbonio-prometheus-node-exporter.service >/dev/null 2>&1 || :
  fi
}

postrm__apt() {
  rm -f /etc/apt/apt.conf.d/100post-apt

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}

postrm__yum() {
  rm -f /etc/dnf/plugins/post-transaction-actions.d/post-dnf.action

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}