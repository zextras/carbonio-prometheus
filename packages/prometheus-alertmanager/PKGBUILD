priority="optional"
arch=('x86_64')
license=('Apache-2.0')
source=(
  "https://github.com/prometheus/alertmanager/releases/download/v${pkgver}/alertmanager-${pkgver}.linux-amd64.tar.gz"
  "131-carbonio-prometheus-alertmanager.sh"
  "alertmanager.yml"
  "alertmanager.yml.ctmpl"
  "email.tmpl"
  "telegram.tmpl"
  "${pkgname}-consul.hcl"
  "${pkgname}.default"
  "${pkgname}.service"
)

