pkgname="carbonio-prometheus-alertmanager"
pkgver="0.34.0"
pkgrel="1"
pkgdesc="Alert manager exporter for open-source systems monitoring and alerting toolkit"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('aarch64' 'x86_64')
license=('Apache-2.0')
depends=("systemd")
conflicts=("prometheus-alertmanager")
backup=(
  "etc/carbonio/${pkgname}/templates/email.tmpl"
  "etc/carbonio/${pkgname}/templates/telegram.tmpl"
)

source=(
  "131-carbonio-prometheus-alertmanager.sh"
  "alertmanager.yml"
  "alertmanager.yml.ctmpl"
  "email.tmpl"
  "telegram.tmpl"
  "${pkgname}-consul.hcl"
  "${pkgname}.default"
  "${pkgname}.service"
)
source_x86_64=(
  "https://github.com/prometheus/alertmanager/releases/download/v${pkgver}/alertmanager-${pkgver}.linux-amd64.tar.gz"
)
source_aarch64=(
  "https://github.com/prometheus/alertmanager/releases/download/v${pkgver}/alertmanager-${pkgver}.linux-arm64.tar.gz"
)
