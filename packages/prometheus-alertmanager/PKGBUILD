package() {
  cd "${srcdir}"

  install -Dm644 "${pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm644 "${pkgname}.default" \
    "${pkgdir}/etc/default/${pkgname}"
  install -Dm644 "${srcdir}/${pkgname}-consul.hcl" \
    "${pkgdir}/etc/zextras/service-discover/${pkgname}.hcl"
  install -Dm644 "${srcdir}/alertmanager.yml.ctmpl" \
    "${pkgdir}/etc/zextras/service-discover/templates/alertmanager.yml.ctmpl"

  install -Dm755 "131-carbonio-prometheus-alertmanager.sh" \
    "${pkgdir}/etc/zextras/pending-setups.d/131-carbonio-prometheus-alertmanager.sh"

  if [ "${CARCH}" = "aarch64" ]; then
    cd "${srcdir}/alertmanager-${pkgver}.linux-arm64"
  else
    cd "${srcdir}/alertmanager-${pkgver}.linux-amd64"
  fi

  install -Dm755 alertmanager \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm755 amtool \
    "${pkgdir}/usr/bin/amtool"

  install -dm750 "${pkgdir}/var/lib/alertmanager/data"
  install -dm750 "${pkgdir}/etc/carbonio/${pkgname}/templates"

  install -Dm644 "${srcdir}/alertmanager.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/config-templates/alertmanager.yml"

  install -Dm644 "${srcdir}/telegram.tmpl" \
    "${pkgdir}/etc/carbonio/${pkgname}/templates/"
  install -Dm644 "${srcdir}/email.tmpl" \
    "${pkgdir}/etc/carbonio/${pkgname}/templates/"
}

postinst() {
  getent group 'carbonio-prometheus' >/dev/null \
    || groupadd -r 'carbonio-prometheus'

  if ! getent passwd 'carbonio-prometheus' >/dev/null; then
    useradd -r -M -g 'carbonio-prometheus' -s /sbin/nologin 'carbonio-prometheus'
  else
    if [ "$(getent passwd 'carbonio-prometheus' | cut -d: -f6)" != "/home/carbonio-prometheus" ]; then
      usermod -d /home/carbonio-prometheus 'carbonio-prometheus'
    fi
  fi

  chown -R carbonio-prometheus:carbonio-prometheus /etc/carbonio/carbonio-prometheus-alertmanager
  chown -R carbonio-prometheus:carbonio-prometheus /var/lib/alertmanager

  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :

    systemctl enable carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
    systemctl start carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Prometheus Alertmanager installed successfully!"
  echo "Run pending-setups to complete the installation"
  echo "Configure the alertmanager in Consul Key Value Store"
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
    systemctl stop carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
