pkgname="carbonio-prometheus-alertmanager"
pkgver="0.29.0"
pkgrel="1"
pkgdesc="Alert manager exporter for open-source systems monitoring and alerting toolkit"
maintainer="Zextras <packages@zextras.com>"
url="https://zextras.com"
section="mail"
priority="optional"
arch=('x86_64')
license=('Apache-2.0')
source=(
  "https://github.com/prometheus/alertmanager/releases/download/v${pkgver}/alertmanager-${pkgver}.linux-amd64.tar.gz"
  "alertmanager.yml"
  "email.tmpl"
  "telegram.tmpl"
  "${pkgname}.default"
  "${pkgname}.service"
  "prometheus.sysusers"
  "${pkgname}.tmpfiles"
)

sha256sums=(
  '24964ccc249aa3e87a0fd24ef1bfc27a567afb31bf9b91dcf8f61cd6df1760ce'
  '29d60f7dbe8e675c77e5d777c14aa3c6f1c8d4332e4cd8ba74fed1854e7a1fad'
  'c5c06342138a154452e7b55c645c2d257952a230f7ea1eae1e4c44e67b6191da'
  'bf885952ba3d2199998ba2fb73f4ab09c176186ec10f25280a8c930739e17a56'
  '54a5a6544397a44b7d1d574032183e9235bf9680ab30e1f8185f4f1b4560c881'
  'c3186cc3e21b19f8d8517d04a2ed93e9a881d809ba1e8d921aeff76d155423ae'
  'a326410b3d37e65266e4036a08c341220e6fc247b35ec327748d427ea1746a56'
  '8690f89dace846f62a5f2727db0093dc4a46a840d01dd62f35e0f93df55e6bee'
  'fc69e3e8419c98b2a153ca9e0014b4bca029896a2646578405ed68129c920066'
)

depends=(
  "systemd"
)

conflicts=(
  "prometheus-alertmanager"
)

backup=(
  "etc/carbonio/${pkgname}/alertmanager.yml"
  "etc/carbonio/${pkgname}/templates/email.tmpl"
  "etc/carbonio/${pkgname}/templates/telegram.tmpl"
)

package() {
  cd "${srcdir}"

  install -Dm644 "${pkgname}.tmpfiles" \
    "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
  install -Dm 644 "${pkgname}.service" \
    "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
  install -Dm 644 "${pkgname}.default" \
    "${pkgdir}/etc/default/${pkgname}"
  install -Dm 644 "prometheus.sysusers" \
    "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"

  cd "${srcdir}/alertmanager-${pkgver}.linux-amd64"

  install -Dm 755 alertmanager \
    "${pkgdir}/usr/bin/${pkgname}"
  install -Dm 755 amtool \
    "${pkgdir}/usr/bin/amtool"

  install -dm 750 "${pkgdir}/var/lib/alertmanager/data"
  install -dm 750 "${pkgdir}/etc/carbonio/${pkgname}/templates"

  install -Dm 644 "${srcdir}/alertmanager.yml" \
    "${pkgdir}/etc/carbonio/${pkgname}/alertmanager.yml"

  install -Dm 644 "${srcdir}/telegram.tmpl" \
    "${pkgdir}/etc/carbonio/${pkgname}/templates/"
  install -Dm 644 "${srcdir}/email.tmpl" \
    "${pkgdir}/etc/carbonio/${pkgname}/templates/"

}

postinst() {
  if hash initctl 2>/dev/null; then
    initctl reload-configuration 2>/dev/null || true
  fi

  systemd-sysusers >/dev/null || true
  systemd-tmpfiles --create >/dev/null || true

  # Migrate carbonio-prometheus user HOME in 25.12: previous versions incorrectly used '/' as HOME
  if [ "${pkgname}" = "carbonio-prometheus" ]; then
    if id carbonio-prometheus >/dev/null 2>&1; then
      current_home="$(getent passwd carbonio-prometheus | cut -d: -f6 || echo "")"
      if [ "${current_home}" = "/" ] || [ -z "${current_home}" ]; then
        mkdir -p /var/lib/carbonio-prometheus || true
        chown carbonio-prometheus:carbonio-prometheus /var/lib/carbonio-prometheus 2>/dev/null || true
        usermod -d /var/lib/carbonio-prometheus carbonio-prometheus 2>/dev/null || true
      fi
    fi
  fi

  if [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || :
  systemctl enable carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
  systemctl start carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
  fi

  echo "======================================================"
  echo "Carbonio Prometheus Alert Manager installed successfully!"
  echo "You can configure it in prometheus.yml"
  echo "======================================================"
}

prerm() {
  if [ -d /run/systemd/system ]; then
    systemctl --no-reload disable carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
    systemctl stop carbonio-prometheus-alertmanager.service >/dev/null 2>&1 || :
  fi
}

postrm() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || :
  fi
}
