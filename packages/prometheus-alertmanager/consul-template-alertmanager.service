[Unit]
Description=Consul Template for Carbonio Alertmanager
After=service-discover.service network-online.target
Wants=service-discover.service network-online.target

[Service]
Type=simple
User=carbonio-prometheus
Group=carbonio-prometheus

ExecStart=/usr/bin/consul-template \
  -config=/etc/zextras/service-discover/templates/carbonio-prometheus-alertmanager-template.hcl

Restart=always
RestartSec=5

# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/carbonio/carbonio-prometheus-alertmanager

[Install]
WantedBy=multi-user.target