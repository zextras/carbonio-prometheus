{{ define "__subject" }} {{ .CommonLabels.alertname }} {{ end }}
{{ define "custom_mail_subject" }} Firing - {{ template "__subject" . }}{{ end }}
{{ define "custom_mail_html" }}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alerts!</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        color: #333;
        margin: 0;
        padding: 20px;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #fff;
        border-radius: 5px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      }

      h1 {
        color: white;
        background-color: #d8411b;
        height: 100px;
        display: block !important;
        max-width: 600px !important;
        margin: 0 auto !important;
        clear: both !important;
      }

      p {
        margin-bottom: 10px;
      }

      .alert {
        padding: 10px;
        border-radius: 3px;
      }

      .footer {
        margin-top: 20px;
        text-align: center;
      }

      .instance {
        display: block !important;
        max-width: 600px !important;
        margin: 0 auto !important;
        clear: both !important;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1> Alert - {{ .CommonLabels.alertname }} </h1>
      <p>Hello,</p>
      <p>You have received the following firing alerts:</p>
      {{ range .Alerts.Firing }}
      <div class="alert">
        <p class="instance">
          <strong>Firing on {{ .Labels.instance }}</strong>
        </p>
        <p><strong>Severity:</strong> {{ .Labels.severity }}</p>
        <p><strong>Message:</strong> {{ .Annotations.summary }}</p>
        <p><strong>Details:</strong> </p>
        <p>
            {{ range .Annotations.SortedPairs }} {{ .Name }} = {{ .Value }}<br />
            {{ end }}
          </p>

          <p>
            {{ range .Labels.SortedPairs }} {{ .Name }} = {{ .Value }}<br />
            {{ end }}
          </p>
        <hr />
      </div>
      {{ end }}
      <div class="footer"></div>
    </div>
  </body>
</html>
{{end}}